# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file.

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# Port the server listens on.
# Keep this at 5002 — the frontend dev server expects the API here
# (see frontend/src/lib/axios.js).
PORT=5002

# Frontend origin allowed by CORS (Vite dev server default)
CLIENT_URL=http://localhost:5173

# Secret used to sign login tokens (JWT). Use a long random string.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

# Upstash Redis (for rate limiting)
UPSTASH_REDIS_REST_URL=https://<your-instance>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<your-upstash-token>
